#!/usr/bin/env python3
"""
mmx-daemon: Wraps MiniMax CLI (mmx) as a persistent interactive process for CCB.

Runs inside a tmux pane. Reads CCB_REQ-prefixed messages from stdin,
calls `mmx text chat`, and outputs replies with CCB_DONE markers.

Multi-line message support: after CCB_REQ:<id>, all subsequent lines
until the next CCB_REQ:/CCB_PING/control command are treated as part
of the same message.
"""
from __future__ import annotations

import json
import os
import subprocess
import sys

REQ_ID_MARKER = "CCB_REQ:"
DONE_MARKER = "CCB_DONE"
HEALTH_PING = "CCB_PING"
HEALTH_PONG = "CCB_PONG"
MSG_END_MARKER = "CCB_MSG_END"
CONSECUTIVE_FAILURE_LIMIT = 3


def call_mmx(message: str, timeout: int = 120) -> str:
    """Call mmx text chat and return the reply."""
    try:
        result = subprocess.run(
            ["mmx", "text", "chat", "--message", message, "--output", "json"],
            capture_output=True,
            text=True,
            timeout=timeout,
            cwd=os.getcwd(),
        )
        if result.returncode == 0:
            try:
                data = json.loads(result.stdout)
                for key in ("output", "text", "content", "response", "result", "message", "reply"):
                    if key in data:
                        val = data[key]
                        if isinstance(val, str):
                            return val
                        return json.dumps(val, ensure_ascii=False)
                return json.dumps(data, ensure_ascii=False, indent=2)
            except json.JSONDecodeError:
                return result.stdout.strip()
        else:
            stderr = result.stderr.strip()
            return f"mmx error (exit {result.returncode}): {stderr or 'unknown error'}"
    except subprocess.TimeoutExpired:
        return "mmx timeout: the request took too long"
    except FileNotFoundError:
        return (
            "mmx CLI not found. Please install:\n"
            "  npm install -g mmx-cli\n"
            "Then authenticate:\n"
            "  mmx auth login --api-key sk-xxxxx"
        )
    except Exception as e:
        return f"mmx exception: {e}"


def main() -> int:
    print("[mmx-daemon] started", flush=True)
    print("CCB_READY", flush=True)

    consecutive_failures = 0
    line_buffer: list[str] = []

    def read_line() -> str | None:
        if line_buffer:
            return line_buffer.pop(0)
        try:
            line = sys.stdin.readline()
            if not line:  # EOF returns empty string, not None
                return None
            return line
        except EOFError:
            return None

    while True:
        raw = read_line()
        if raw is None:
            break

        line = raw.strip()
        if not line:
            continue

        if line.lower() in ("exit", "quit", "shutdown"):
            print("[mmx-daemon] shutting down", flush=True)
            break

        if line == HEALTH_PING:
            status = "healthy" if consecutive_failures < CONSECUTIVE_FAILURE_LIMIT else "degraded"
            print(f"{HEALTH_PONG} {status}", flush=True)
            continue

        # Extract req_id and message
        req_id = ""
        message = line
        if line.startswith(REQ_ID_MARKER):
            req_id = line[len(REQ_ID_MARKER):].strip()
            # Read the rest of the message (multi-line support)
            message_lines = []
            while True:
                next_raw = read_line()
                if next_raw is None:
                    break
                stripped = next_raw.strip()
                if stripped == MSG_END_MARKER:
                    break
                if (
                    stripped.startswith(REQ_ID_MARKER)
                    or stripped == HEALTH_PING
                    or stripped.lower() in ("exit", "quit", "shutdown")
                ):
                    # Put it back for the next loop iteration
                    line_buffer.append(next_raw)
                    break
                message_lines.append(next_raw)
            # Strip trailing newline from the last line only
            if message_lines:
                message_lines[-1] = message_lines[-1].rstrip("\n")
            message = "".join(message_lines)

        reply = call_mmx(message)

        if reply.startswith("mmx error") or reply.startswith("mmx timeout") or reply.startswith("mmx exception"):
            consecutive_failures += 1
            if reply.startswith("mmx CLI not found"):
                print(f"[mmx-daemon] FATAL: {reply}", flush=True)
                print(reply, flush=True)
                print(DONE_MARKER, flush=True)
                return 1
        else:
            consecutive_failures = 0

        if req_id:
            print(f"{REQ_ID_MARKER}{req_id}", flush=True)
        print(reply, flush=True)
        print(DONE_MARKER, flush=True)

        if consecutive_failures >= CONSECUTIVE_FAILURE_LIMIT:
            print(
                f"[mmx-daemon] {consecutive_failures} consecutive failures; "
                f"daemon is degraded but still running",
                flush=True,
            )
            consecutive_failures = 0

    print("[mmx-daemon] exited", flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
