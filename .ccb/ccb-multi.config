# ============================================================
# CCB 多窗口布局 — v8.0.16
# ============================================================
# 三个 tmux 窗口，用 Ctrl+b n/p 切换

version = 2

entry_window = "main"

[windows]
main   = "planner:codex; inspiration:opencode"
work   = "executor:codex; reviewer:claude"
test   = "tester:kimi"

[ui.sidebar]
mode = "every_window"
width = "15%"
bottom_height = 20

[ui.sidebar.view]
agents_height = "50%"
comms_height = "15%"
tips_height = "35%"
comms_limit = 5

[agents.planner]
description = "方案设计 - 负责系统架构、技术选型、模块划分"

[agents.inspiration]
description = "弹性协作 - 跳过发散视角、由 Orchestrator 补充备选方案，或按被替代角色规范代执行"

[agents.executor]
description = "核心开发 - 严格遵循编码规范、不可变性、错误处理、输入验证，按 TDD 流程实现功能"

[agents.reviewer]
description = "代码审查 - 负责代码质量、潜在风险、最佳实践检查、组件和函数的拆分合理性评估"
model = "claude-sonnet-4-20250514"
permission = "manual"
queue_policy = "serial-per-agent"

[agents.tester]
description = "执行分析测试 - 负责命令执行、结果分析、回归测试"
