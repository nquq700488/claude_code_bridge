# ============================================================
# CCB 项目配置 - 角色化分屏布局
# ============================================================
#
# 分屏布局（5 agent + cmd，2行3列）：
# ┌─────────────┬─────────────┬─────────────┐
# │  architect  │   reviewer  │   opencode  │
# │  (codex)    │   (claude)  │  (opencode) │
# ├─────────────┼─────────────┼─────────────┤
# │     cmd     │   developer │   executor  │
# │  (shell)    │   (codex)   │   (kimi)    │
# └─────────────┴─────────────┴─────────────┘
#
# ; = 左右分割    , = 上下堆叠    () = 分组
# ============================================================
(architect, cmd; reviewer, developer; opencode, executor)

# ============================================================
# Agent 角色定义
# ============================================================

[agents.architect]
description = "方案设计 - 负责系统架构、技术选型、模块划分"
# model = "gpt-5"
# key = "sk-..."

[agents.developer]
description = "核心开发 - 负责编码实现、功能开发、Bug修复"
# model = "o3"
# key = "sk-..."

[agents.reviewer]
description = "代码审查 - 负责代码质量、潜在风险、最佳实践检查"
# url = "https://chat.nuoda.vip/claudecode"
# key = "sk-ant-..."
model = "claude-sonnet-4-20250514"
permission = "manual"
queue_policy = "serial-per-agent"

[agents.mmx]
description = "MiniMax 创意助手 - 负责创意生成、内容创作"

[agents.executor]
description = "执行分析测试 - 负责命令执行、结果分析、回归测试"
# model = "kimi-latest"
# key = "..."

[agents.opencode]
description = "OpenCode 智能助手 - 负责技术调研、快速原型和代码实现"
