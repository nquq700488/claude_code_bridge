# CCB 配置档案路由器
# 切换模式：改下面这行的值，然后 ccb reload
# compact = 紧凑单窗口 / multi = 多窗口
config_profile = "compact"

# ── 共享配置（teams/providers 写在这里，compact 和 multi 都能用）────────

[teams.team]
topology = "mesh"
description = "真实项目 Team — 用当前运行中的 agent 演示群聊 UI"

[[teams.team.members]]
name = "planner"
provider = "codex"
description = "方案设计 - 系统架构、技术选型"

[[teams.team.members]]
name = "developer"
provider = "claude"
description = "核心开发 - TDD 实现功能"

[[teams.team.members]]
name = "reviewer"
provider = "codex"
description = "代码审查 - 质量保证"

[[teams.team.members]]
name = "tester"
provider = "claude"
description = "测试分析 - 执行与回归"
