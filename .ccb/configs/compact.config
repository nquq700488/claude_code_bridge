# ============================================================
# CCB 紧凑布局（单窗口） — v8.0.16
# ============================================================
#
# 所有 Agent 在同一个 tmux 窗口中
# 布局:
# ┌───────────────┬───────────────┐
# │    planner    │  inspiration  │
# │    (codex)    │  (opencode)   │
# ├───────────────┼───────────────┼───────────────┐
# │   executor    │   reviewer    │    tester      │
# │   (codex)     │   (claude)    │   (kimi)       │
# └───────────────┴───────────────┴───────────────┘

(planner:codex; inspiration:opencode), (executor:codex; reviewer:claude; tester:kimi)

[agents.planner]
description = "方案设计 - 负责系统架构、技术选型、模块划分"

[agents.executor]
description = "核心开发 - 严格遵循编码规范、不可变性、错误处理、输入验证，按 TDD 流程实现功能"

[agents.reviewer]
description = "代码审查 - 负责代码质量、潜在风险、最佳实践检查、组件和函数的拆分合理性评估"
model = "claude-sonnet-4-20250514"
permission = "manual"
queue_policy = "serial-per-agent"

[agents.tester]
description = "执行分析测试 - 负责命令执行、结果分析、回归测试"

[agents.inspiration]
description = "弹性协作 - 跳过发散视角、由 Orchestrator 补充备选方案，或按被替代角色规范代执行"
