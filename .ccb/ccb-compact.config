# ============================================================
# CCB 项目配置 - 角色化分屏布局
# ============================================================
#
# === 布局语法 ===
#
#   agent_name:provider  =  agent 节点（例如 planner:codex）
#   agent_name:provider(N)=  带权重的节点，N 为权重（默认 1），例如 db:codex(2)
#   cmd                  =  命令槽位（在窗格中启动 shell）
#   A , B                =  垂直分割：A 在上，B 在下
#   A ; B                =  水平分割：A 在左，B 在右
#   ( ... )              =  分组，改变默认优先级
#
#   优先级：( 分组 ) > , 垂直 > ; 水平
#   结合性：, 和 ; 都是左结合
#
# === 比例规则 ===
#
#   每层按权重总和计算比例：
#     right_pct = round(right_weight_sum / total_weight_sum × 100%)
#   权重越大的节点分到的空间越多，不写默认为 1。
#
#   左右两边的权重总和相等时，行列自然对齐。
#   如果两边权重总和不相等，会产生不对齐的行高。
#
# === 示例 ===
#
#   a, b; c, d           →  左列 a+b (各50%)，右列 c+d (各50%)，对齐 ✓
#   a, b; c, d, e        →  左列 2个(40%)，右列 3个(60%)，行高不对齐
#   (a; b), (c; d; e)    →  上排 a|b (各50%)，下排 c|d|e (≈33%各)
#   a(2), b; c           →  a 占 67%, b 占 33%, c 单独一列
#
# ============================================================
(planner:codex; developer:claude), (reviewer:codex; tester:kimi)

# ============================================================
# Agent 角色定义
# ============================================================

[agents.planner]
description = "方案设计 - 负责系统架构、技术选型、模块划分"
# model = "gpt-5"
# key = "sk-..."

[agents.developer]
description = "核心开发 - 严格遵循编码规范、不可变性、错误处理、输入验证，按 TDD 流程实现功能"
# model = "o3"
# key = "sk-..."

[agents.reviewer]
description = "代码审查 - 负责代码质量、潜在风险、最佳实践检查、组件和函数的拆分合理性评估"
# url = "https://chat.nuoda.vip/claudecode"
# key = "sk-ant-..."
model = "claude-sonnet-4-20250514"
permission = "manual"
queue_policy = "serial-per-agent"

[agents.tester]
description = "执行分析测试 - 负责命令执行、结果分析、回归测试"
# model = "kimi-latest"
# key = "..."

# [agents.inspiration]
# description = "弹性协作 - 跳过发散视角、由 Orchestrator 补充备选方案，或按被替代角色规范代执行"
